<div class="chronicle">
  <h1><%= game_name %> Chronicle</h1>

  <div class="chronicle__entries">
    <% entries.each do |entry| %>
      <% new_turn = entry.event_type == "Game::NewTurnStarted" %>
      <p class="chronicle__entry <%= new_turn ? "chronicle__entry--turn" : "chronicle__entry--event" %>"><%= entry.text %></p>
    <% end %>
  </div>
</div>
